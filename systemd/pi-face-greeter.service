[Unit]
Description=Pi Face Greeter kiosk app
After=graphical-session.target sound.target
Wants=graphical-session.target

[Service]
Type=simple
WorkingDirectory=/home/USER/pi_face_greeter
Environment=PYTHONUNBUFFERED=1
Environment=DISPLAY=:0
ExecStart=/home/USER/pi_face_greeter/.venv/bin/pi-face-greeter-app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target

# User service (recommended for Kivy on the DSI display):
#   Edit USER, WorkingDirectory, and ExecStart above, then:
#   mkdir -p ~/.config/systemd/user
#   cp systemd/pi-face-greeter.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable pi-face-greeter
#   systemctl --user start pi-face-greeter
#
# Optional PIR loop (headless): use pi-face-greeter instead of pi-face-greeter-app.
#
# Manual start (also ensures Ollama is up): ./scripts/start.sh
