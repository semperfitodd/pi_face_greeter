[Unit]
Description=Pi Face Greeter
After=network.target sound.target
Wants=network.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/pi_face_greeter
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/pi_face_greeter/.venv/bin/pi-face-greeter
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

# Install (after hardware validation — do not enable until tested):
#   sudo cp systemd/pi-face-greeter.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable pi-face-greeter
#   sudo systemctl start pi-face-greeter
#   sudo systemctl status pi-face-greeter
#
# Update User, WorkingDirectory, and ExecStart paths to match your setup.
